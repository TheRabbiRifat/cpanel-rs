# cPanel Rust Client - Environment Variables
# Copy this file to .env and fill in your credentials

# Required
CPANEL_HOST=your-server.example.com
CPANEL_PORT=2087
CPANEL_USER=your_whm_username
CPANEL_PASSWORD=your_whm_password

# Optional (for token-based auth, skip PASSWORD)
# CPANEL_TOKEN=your-api-token
